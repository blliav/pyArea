<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyArea Calculation Setup" 
        Width="1200" Height="760"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Grid row styling: group rows (Calculation / Sheet) get colored backgrounds -->
        <Style x:Key="HierarchyRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Height" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowType}" Value="Calculation">
                    <Setter Property="Background" Value="#CFE0F1"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowType}" Value="Sheet">
                    <Setter Property="Background" Value="#EAEAEA"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowType}" Value="NotPlaced">
                    <Setter Property="Background" Value="#F5E6CC"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HierarchyCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0,2,0"/>
            <Setter Property="MinHeight" Value="18"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3399FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="500"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANEL: Tree-Table Hierarchy -->
        <Grid Grid.Column="0" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Area Scheme Selector Row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <ComboBox x:Name="combo_areascheme" Width="260" ToolTip="Select Area Scheme"/>
                <Button x:Name="btn_edit_scheme" Width="28" Height="28" Margin="5,5,0,5" Padding="0"
                        MinWidth="0" ToolTip="Edit Area Scheme properties"
                        FontFamily="Segoe UI Symbol" FontSize="13" Content="&#x270E;"/>
                <TextBlock x:Name="text_selection_info" Margin="15,0,0,0" Foreground="Gray" FontStyle="Italic"/>
            </StackPanel>
            
            <!-- Tree-Table Grid -->
            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,10" Background="White">
                <DataGrid x:Name="grid_hierarchy"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          VerticalGridLinesBrush="#E8E8E8"
                          RowHeaderWidth="0"
                          Background="White"
                          BorderThickness="0"
                          FrozenColumnCount="1"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          RowStyle="{StaticResource HierarchyRowStyle}"
                          CellStyle="{StaticResource HierarchyCellStyle}"
                          FontSize="10.5"
                          RowHeight="20"/>
            </Border>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button x:Name="btn_add" Content="➕" Width="180" ToolTip="Add new element"/>
                <Button x:Name="btn_remove" Content="🗑 Remove" ToolTip="Remove data from selected element(s)"/>
            </StackPanel>
        </Grid>
        
        <!-- SPACING (no splitter bar) -->
        <Grid Grid.Column="1" Background="#F5F5F5"/>
        
        <!-- RIGHT PANEL: Properties -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title Section (outside panel frame) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,5">
                <!-- Element Name (aligned with frame top) -->
                <TextBlock x:Name="text_fields_title" 
                           Text="Select an element from the tree" 
                           FontSize="14" 
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#333333"
                           Margin="0,0,0,2"/>
                <!-- Element Details (below frame) -->
                <TextBlock x:Name="text_fields_subtitle" 
                           Text="" 
                           FontSize="12" 
                           FontWeight="Normal"
                           TextTrimming="CharacterEllipsis"
                           Foreground="Gray"
                           Margin="0,0,0,0"/>
            </StackPanel>
            
            <!-- Data Fields (Main Focus) -->
            <GroupBox Grid.Row="1" Padding="5" Margin="0,0,0,10" Background="#F5F5F5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F5F5">
                    <StackPanel x:Name="panel_fields" Background="#F5F5F5"/>
                </ScrollViewer>
            </GroupBox>
            
            <!-- JSON Data Panel -->
            <GroupBox Grid.Row="2" Header="JSON Data" Padding="5" Margin="0,0,0,10" 
                      FontSize="11" Foreground="#555555" Background="#F5F5F5">
                <Border BorderThickness="1" BorderBrush="#CCCCCC" Background="#F5F5F5"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <TextBox x:Name="text_json" 
                             Text="Select an element to view its JSON data..." 
                             Foreground="Gray" Background="#F5F5F5"
                             IsReadOnly="True" BorderThickness="0"
                             FontFamily="Consolas" FontSize="9"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Height="Auto"
                             Margin="0"
                             Padding="5"/>
                </Border>
            </GroupBox>
            
            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" x:Name="btn_close" Content="Close" IsCancel="True"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
